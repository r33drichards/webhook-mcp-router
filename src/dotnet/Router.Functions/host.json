{
  "version": "2.0",
  "functionTimeout": "00:01:00",
  "extensions": {
    "mcp": {
      "serverName": "webhook-mcp-router",
      "serverVersion": "0.0.1",
      "system": {
        "webhookAuthorizationLevel": "System"
      }
    },
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:00:30",
      "maxPollingInterval": "00:01:00",
      "messageEncoding": "base64"
    }
  }
}
